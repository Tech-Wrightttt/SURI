# SURI Environment Variables

# Gemini API key (lesson simplification, step feedback, quiz feedback at runtime;
# also used by the offline content/problem generation scripts).
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Supabase PostgreSQL connection string (Transaction Pooler URI, port 6543 recommended)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# JWT secret (change in production!)
JWT_SECRET=dev-secret-change-in-production
