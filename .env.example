# SURI Environment Variables

# Gemini API key (lesson simplification, step feedback, quiz feedback at runtime;
# also used by the offline content/problem generation scripts).
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Supabase PostgreSQL connection string (Transaction Pooler URI, port 6543 recommended)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# JWT secret (change in production!)
JWT_SECRET=dev-secret-change-in-production

# Comma-separated emails of tester accounts. These accounts see the correct
# answer on diagnostic, practice, quiz and playground questions, and can open
# every node on the Progress page. Leave empty in production.
DEBUG_ACCOUNT_EMAILS=

